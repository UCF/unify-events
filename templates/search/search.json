{% load core_tags %}
{
    "count": {{ page_obj.paginator.count }},
    "next": "{% if page_obj.has_next %}{% absolute_uri_query_transform page=page_obj.next_page_number %}{% endif %}",
    "previous": "{% if page_obj.has_previous %}{% absolute_uri_query_transform page=page_obj.previous_page_number %}{% endif %}",
    "results": [
        {% with results=object_list %}
            {% if results %}

            {% comment %}
            Prioritize Main Calendar events. Assume that Main Calendar events
            will always be copied from somewhere else.

            Fall back to the result itself when the Main Calendar copy has no
            instances, mirroring search.html. get_main_event() applies no
            instance filter, so a copy that failed part-way through
            Event.copy() would otherwise render "url" and "details" as the
            string "None" -- get_absolute_url/get_json_details return None for
            an instance-less event. The queryset guarantees `result` has at
            least one instance.

            Events use the first instance's search-list-item.html esi template.
            See esi/eventinstance/search-list-item.html for info.
            {% endcomment %}

                {% block results_list %}

                {% for result in results %}
                    {% with main_event=result.get_main_event %}
                    {% if main_event.get_first_instance %}
                    {% with item=main_event %}{% include 'search/search-result.json' %}{% endwith %}
                    {% else %}
                    {% with item=result %}{% include 'search/search-result.json' %}{% endwith %}
                    {% endif %}
                    {% endwith %}
                    {% if not forloop.last %},{% endif %}
                {% endfor %}

                {% endblock %}

            {% endif %}
        {% endwith %}
    ]
}
